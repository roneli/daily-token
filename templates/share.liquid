<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="The Daily Token">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ image }}">
<meta http-equiv="refresh" content="0; url={{ issue }}">
<style>body { font: 16px/1.5 system-ui, sans-serif; margin: 40px 16px; text-align: center; } a { color: #2b5bd7; }</style>
</head>
<body>
<p><a href="{{ issue }}">Open {{ title }}</a></p>
</body>
</html>
