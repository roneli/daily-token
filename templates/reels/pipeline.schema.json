{
  "$id": "pipeline",
  "description": "A token moves through 2-6 steps. Events stop it at a step (bad, then good). Metrics show a before and after.",
  "type": "object",
  "additionalProperties": false,
  "required": ["steps", "events", "metrics"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sub"],
        "properties": { "name": { "type": "string", "maxLength": 10 }, "sub": { "type": "string", "maxLength": 16 } }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "kind", "text"],
        "properties": {
          "step": { "type": "integer", "minimum": 0, "maximum": 5 },
          "kind": { "enum": ["bad", "good"] },
          "text": { "type": "string", "maxLength": 72 },
          "ref": { "oneOf": [{ "type": "integer" }, { "type": "string", "pattern": "^[\\w.-]+#\\d+$" }, { "type": "string", "pattern": "^([\\w.-]+@)?[0-9a-f]{7}$" }] }
        }
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "before", "after"],
        "properties": {
          "label": { "type": "string", "maxLength": 22 },
          "before": { "type": "string", "maxLength": 26 },
          "after": { "type": "string", "maxLength": 26 },
          "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "ref": { "oneOf": [{ "type": "integer" }, { "type": "string", "pattern": "^[\\w.-]+#\\d+$" }, { "type": "string", "pattern": "^([\\w.-]+@)?[0-9a-f]{7}$" }] }
        }
      }
    }
  }
}
