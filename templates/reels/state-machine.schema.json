{
  "description": "A token moves between 2-5 states in a row, plus an optional branch state below one of them, over 1-2 runs. A status row shows the state and a line as the token moves.",
  "type": "object",
  "additionalProperties": false,
  "required": ["states", "status", "runs"],
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 16 },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sub"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "maxLength": 12 },
        "sub": { "type": "string", "maxLength": 18 }
      }
    }
  },
  "properties": {
    "states": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/definitions/state" } },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sub", "from"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "maxLength": 12 },
        "sub": { "type": "string", "maxLength": 18 },
        "from": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "maxLength": 12 }
      }
    },
    "loop": { "type": "string", "maxLength": 16, "description": "Label for a dashed arrow from the last state back to the first." },
    "status": { "type": "string", "maxLength": 22, "description": "The status row's label, e.g. a page and a record." },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caption", "start", "steps"],
        "properties": {
          "caption": { "type": "string", "maxLength": 28 },
          "start": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "line"],
            "properties": { "state": { "type": "string", "maxLength": 12 }, "line": { "type": "string", "maxLength": 40 } }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["to", "state", "line"],
              "properties": {
                "to": { "$ref": "#/definitions/id" },
                "state": { "type": "string", "maxLength": 12 },
                "line": { "type": "string", "maxLength": 40 },
                "tone": { "enum": ["on", "bad", "good"] },
                "note": { "type": "string", "maxLength": 14 }
              }
            }
          }
        }
      }
    }
  }
}
