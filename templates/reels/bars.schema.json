{
  "$id": "bars",
  "description": "Stacked bars per day (up to 7) for up to 4 series, with optional milestones above days and a note.",
  "type": "object",
  "additionalProperties": false,
  "required": ["series", "days"],
  "properties": {
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "maxLength": 18 }, "neutral": { "type": "boolean" } }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "values"],
        "properties": {
          "label": { "type": "string", "maxLength": 8 },
          "values": { "type": "array", "maxItems": 4, "items": { "type": "integer", "minimum": 0 } },
          "today": { "type": "boolean" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "text"],
        "properties": { "day": { "type": "integer", "minimum": 0, "maximum": 6 }, "text": { "type": "string", "maxLength": 20 } }
      }
    },
    "note": { "type": "string", "maxLength": 90 }
  }
}
