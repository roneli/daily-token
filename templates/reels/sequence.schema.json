{
  "description": "2-3 actors with lifelines. Messages travel between them as arrows a token follows; one can be crossed out, a reply can be refused or accepted, and an actor can flash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["actors", "messages"],
  "definitions": {
    "tone": { "enum": ["ink", "secret", "bad", "good"] },
    "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tone"],
      "properties": { "text": { "type": "string", "maxLength": 22 }, "tone": { "enum": ["bad", "good"] } }
    }
  },
  "properties": {
    "actors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 12 } } }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "label", "tone"],
        "properties": {
          "from": { "type": "integer", "minimum": 0, "maximum": 2 },
          "to": { "type": "integer", "minimum": 0, "maximum": 2 },
          "label": { "type": "string", "maxLength": 34 },
          "label2": { "type": "string", "maxLength": 34 },
          "tone": { "$ref": "#/definitions/tone" },
          "label2Tone": { "$ref": "#/definitions/tone" },
          "tag": { "type": "string", "maxLength": 14, "description": "A short note beside the arrow, e.g. before or now." },
          "struck": { "type": "boolean", "description": "Cross the arrow out after it lands: what used to happen and no longer does." },
          "same": { "type": "boolean", "description": "Continue on the previous message's row, e.g. a second hop." },
          "result": { "$ref": "#/definitions/mark" },
          "flash": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor", "tone"],
            "properties": { "actor": { "type": "integer", "minimum": 0, "maximum": 2 }, "tone": { "enum": ["bad", "good"] } }
          }
        }
      }
    },
    "note": { "type": "string", "maxLength": 64 }
  }
}
