{
  "$id": "counter-timeline",
  "description": "Up to 3 counters count up, then up to 6 tags drop onto a time axis, then an optional note.",
  "type": "object",
  "additionalProperties": false,
  "required": ["counters", "axis", "tags"],
  "properties": {
    "counters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "integer", "minimum": 0, "maximum": 999999 },
          "label": { "type": "string", "maxLength": 22 },
          "prefix": { "type": "string", "maxLength": 2 },
          "suffix": { "type": "string", "maxLength": 3 },
          "minus": { "type": "integer", "minimum": 0, "maximum": 99999, "description": "Shown smaller beside the value, e.g. lines removed next to lines added." }
        }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }, "to": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" } }
    },
    "tags": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "at"],
        "properties": {
          "name": { "type": "string", "maxLength": 18 },
          "at": { "type": "string" },
          "kind": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    },
    "note": { "type": "string", "maxLength": 60 }
  }
}
