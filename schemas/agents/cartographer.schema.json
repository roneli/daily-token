{
  "type": "object",
  "additionalProperties": false,
  "required": ["parts", "groups", "edges", "ignore", "notes"],
  "properties": {
    "parts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "name", "sub", "what", "paths"], "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "name": { "type": "string", "maxLength": 24 }, "sub": { "type": "string", "maxLength": 34 }, "what": { "type": "string", "maxLength": 140 },
      "paths": { "type": "array", "items": { "type": "string" } }, "core": { "type": "boolean" } } } },
    "groups": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "kind", "members"], "properties": {
      "label": { "type": "string" }, "kind": { "enum": ["zone", "frame"] }, "members": { "type": "array", "items": { "type": "string" } }, "parent": { "type": "string" } } } },
    "edges": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["from", "to", "label"], "properties": {
      "from": { "type": "string" }, "to": { "type": "string" }, "label": { "type": "string", "maxLength": 30 }, "dashed": { "type": "boolean" } } } },
    "ignore": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["change", "why"], "properties": { "change": { "type": "string" }, "why": { "type": "string" } } } }
  }
}
