{
  "name": "daily-token",
  "version": "0.2.0",
  "description": "A daily digest of what landed in a project: collected from its sources, written and cut into reels by agents, checked against the data.",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "daily-token": "src/cli.ts"
  },
  "files": [
    "src/**/*.ts",
    "src/**/*.mjs",
    "!**/*.test.ts",
    "agents",
    "schemas",
    "templates",
    "static",
    "fixtures/sample",
    "starter"
  ],
  "workspaces": [
    "deploy/*"
  ],
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "ajv": "8.20.0",
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "elkjs": "0.12.0",
    "htmlparser2": "12.0.0",
    "kokoro-js": "1.2.1",
    "liquidjs": "10.30.0",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
