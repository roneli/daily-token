# Copy to .env. The GitHub Action sets the same names as secrets and variables.

# Agents run through the claude CLI: locally your login, in CI one of these
ANTHROPIC_API_KEY=
# AGENT_MODEL=opus          default model; MODEL_WRITER, MODEL_EDITOR, MODEL_DIRECTOR, MODEL_READER override it

# Read-only fine-grained token for the project's repos: contents, pull requests, issues
GH_TOKEN=
# The project's data root (project.json, system.json, issues/), outside this repo
DATA_DIR=../daily-token-data

# The window runs from one cutoff to the next, in this time zone (defaults: UTC, 00:00)
DIGEST_TZ=UTC
CUTOFF=00:00

# Optional: the issues bucket, any S3-compatible store (AWS S3, Cloudflare R2, MinIO, B2). S3_ENDPOINT is the full URL;
# S3_REGION only where the store needs one (AWS). The old R2_* names are still read.
S3_ENDPOINT=
S3_BUCKET=daily-token
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: the Cloudflare Worker (or run `daily-token serve` anywhere): its custom domain, and from Zero Trust the team domain (https://<team>.cloudflareaccess.com)
# and the Access app's Application Audience (AUD) tag
CLOUDFLARE_API_TOKEN=
WORKER_DOMAIN=
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
SITE_URL=

# Slack incoming webhook for the allowed channel
SLACK_WEBHOOK_URL=
